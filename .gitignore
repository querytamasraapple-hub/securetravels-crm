.tools/

# Secrets — NEVER commit these
app-boot*.cmd
app-boot*.sh
*.env
.env.*

# Temporary / local-only logs and caches
temp/
*.log
tmp/

# OSV Scanner binary (downloaded, not source)
osv-scanner*

# OWASP reports (stored in TEMP outside repo, excluded as a safety net)
owasp-evidence/
dependency-check-report*

# Backup copies of committed files — never stage
*.bak
